{
    "name": "jauntin/pdf-platform-sdk",
    "description": "SDK for integrating with Jauntin's PDF platform",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "jauntin",
        "pdf-platform-sdk"
    ],
    "authors": [
        {
            "name": "Sid Momin",
            "email": "sid@jauntin.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/jauntin/pdf-platform-sdk",
    "require": {
        "php": ">=8.3 <8.4",
        "illuminate/support": "^12.0",
        "jawira/case-converter": "^3.4"
    },
    "require-dev": {
        "laravel/pint": "^1.29.3",
        "mockery/mockery": "^1.6.12",
        "orchestra/testbench": "^10.11.0",
        "phpstan/phpstan": "^2.2.5",
        "phpunit/phpunit": "^12.5.31"
    },
    "autoload": {
        "psr-4": {
            "Jauntin\\PdfPlatformSdk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jauntin\\PdfPlatformSdk\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jauntin\\PdfPlatformSdk\\PdfPlatformSdkServiceProvider"
            ]
        }
    }
}
